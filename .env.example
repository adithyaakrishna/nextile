# Public URL of the site: share links, metadata and preview images. Needed at build time and at run time.
PUBLIC_ORIGIN=http://localhost:3000
# SQLite file on persistent disk. Use an absolute path in production.
DATABASE_PATH=./data/nextile.db
# [Confirm] Teeny Tiny Computer URL; until set, attribution links point at /about. Needed at build time.
TTC_URL=

# Local only: the server refuses to start with any of these unless PUBLIC_ORIGIN is explicitly a localhost address.
# NX_NOW=2026-11-18T12:00:00Z   start the server clock at this instant (try the game before launch)
# E2E=1                         enables POST /api/test/clock
# NX_CONTENT=fixture            serves tests/fixtures/puzzles.ts instead of the real collection
